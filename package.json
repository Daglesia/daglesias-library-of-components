{
  "name": "@daglesia/daglesias-library-of-components",
  "version": "1.0.0",
  "description": "Daglesia's Library of Components - CSS and SCSS for building web interfaces for Daglesia's ecosystem.",
  "license": "MIT",
  "main": "dist/daglesias-library-of-components.css",
  "style": "dist/daglesias-library-of-components.css",
  "sass": "src/index.scss",
  "files": [
    "dist",
    "src",
    "AI_GUIDE.md"
  ],
  "exports": {
    ".": {
      "sass": "./src/index.scss",
      "style": "./dist/daglesias-library-of-components.css",
      "default": "./dist/daglesias-library-of-components.css"
    },
    "./scss": "./src/index.scss",
    "./scss/*": "./src/*.scss",
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "registry": "https://git.daglesia.com/api/packages/magdalena/npm/"
  },
  "scripts": {
    "build": "npm run build:css && npm run build:min",
    "build:css": "sass src/index.scss dist/daglesias-library-of-components.css --style=expanded --no-source-map",
    "build:min": "sass src/index.scss dist/daglesias-library-of-components.min.css --style=compressed --no-source-map",
    "watch": "sass --watch src/index.scss:dist/daglesias-library-of-components.css"
  },
  "devDependencies": {
    "sass": "^1.101.7"
  },
  "keywords": [
    "css",
    "scss",
    "sass",
    "bem",
    "component-library",
    "design-system"
  ]
}
